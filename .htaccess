# =========================================================================
#  Root .htaccess — redirects the project root to the public/ folder so the
#  app works even when the whole project folder is placed in the web root.
#  On most shared hosts you can simply point the document root to /public.
# =========================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # If someone visits the project root, send them into /public.
    RewriteRule ^$ public/ [L]

    # Don't rewrite real files or folders.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route everything else through the public front controller.
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>

# Block direct access to application internals.
RedirectMatch 403 ^/.*/(app|config|database|storage|node-server)/.*$

Options -Indexes
